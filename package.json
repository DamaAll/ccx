{
  "name": "ccx",
  "version": "0.1.0",
  "description": "Agent Teams control plane for Claude Code — observability, cost tracking, and team topology reuse",
  "type": "module",
  "bin": {
    "ccx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "claude-code",
    "claude",
    "agent-teams",
    "monitoring",
    "dashboard",
    "observability",
    "cost-tracking",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DamaAll/ccx.git"
  },
  "author": "DamaAll",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
